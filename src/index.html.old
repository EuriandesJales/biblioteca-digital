  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BIBLIOTECH — Biblioteca Digital</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap" rel="stylesheet">
  <style>
    :root{
      --blue:#00167A;
      --paper:#E2D4BB;
      --gold:#A18000;
      --cream:#FFEDCD;
      --black:#000000;
      --blue-deep:#000d4b;
      --gold-light:#c6a629;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--black);font-family:"DM Sans",sans-serif}
    .app-shell{width:100%;overflow:hidden;background:
      radial-gradient(circle at 82% 6%,rgba(161,128,0,.18),transparent 25%),
      linear-gradient(180deg,#E2D4BB 0%,#f1e5d1 45%,#E2D4BB 100%)}
    .brand-word{font-family:"Fraunces",serif;letter-spacing:.08em}
    .tech-grid{background-image:linear-gradient(rgba(0,22,122,.10) 1px,transparent 1px),linear-gradient(90deg,rgba(0,22,122,.10) 1px,transparent 1px);background-size:32px 32px}
    .glow{box-shadow:0 0 0 1px rgba(161,128,0,.25),0 18px 50px rgba(0,0,0,.15)}
    .nav-link{color:var(--cream);transition:color .2s ease}
    .nav-link:hover,.nav-link:focus-visible{color:#f4cf57}
    .search-field{background:var(--cream);border:1px solid var(--gold);color:var(--black)}
    .search-field::placeholder{color:#544a39;opacity:1}
    .book-card{border:1px solid rgba(0,22,122,.22);background:rgba(255,237,205,.88);box-shadow:0 12px 28px rgba(0,0,0,.09);transition:transform .24s ease,border-color .24s ease,box-shadow .24s ease}
    .book-card:hover{transform:translateY(-4px);border-color:var(--gold);box-shadow:0 18px 34px rgba(0,22,122,.17)}
    .cover{aspect-ratio:3/4;object-fit:cover}
    .category-chip{border:1px solid var(--blue);color:var(--blue);background:rgba(255,237,205,.6);transition:all .2s ease}
    .category-chip:hover,.category-chip.active{background:var(--gold);border-color:var(--gold);color:var(--black)}
    .icon-button{border:1px solid rgba(0,22,122,.38);color:var(--blue);transition:all .2s ease}
    .icon-button:hover,.icon-button.is-favorite{color:var(--cream);border-color:var(--blue);background:var(--blue)}
    .modal-backdrop{background:rgba(0,0,0,.72);backdrop-filter:blur(7px)}
    .modal-panel{max-height:calc(88 * min(var(--vh, 1vh), 1vh))}
    .toast{transform:translateY(130%);transition:transform .25s ease}
    .toast.show{transform:translateY(0)}
    :focus-visible{outline:3px solid var(--gold);outline-offset:3px}
    .hidden-card{display:none!important}
    .cream-on-blue{color:var(--cream)}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.577.0/dist/umd/lucide.min.js" type="text/javascript"></script>
  <script src="https://cdn.tailwindcss.com/3.4.17" type="text/javascript"></script>
