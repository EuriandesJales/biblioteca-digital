   <main>
    <section id="inicio" class="tech-grid relative border-b border-[#00167A]/20">
     <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 lg:grid-cols-[1.15fr_.85fr] lg:px-8 lg:py-20">
      <div class="relative z-10">
       <p data-template-id="hero-kicker" class="canva-text mb-4 font-semibold uppercase tracking-[.22em]" style="color: rgb(161, 128, 0); font-weight: 700; font-style: normal; font-size: 13px;">Conhecimento conectado</p>
       <h1 data-template-id="hero-title" class="canva-text max-w-3xl font-['Fraunces'] font-bold" style="color: rgb(0, 22, 122); font-weight: 700; font-style: normal; font-size: 32px;">Toda grande descoberta começa em uma página.</h1>
       <p data-template-id="hero-description" class="canva-text mt-5 max-w-xl leading-7" style="color: rgb(0, 0, 0); font-weight: 400; font-style: normal; font-size: 17px; line-height: 1.6;">Explore histórias, ideias e mundos inteiros na sua biblioteca digital feita para leitores curiosos.</p><label data-template-id="search-label" for="book-search" class="canva-text sr-only" style="font-weight: 400; font-style: normal; font-size: 16px;">Pesquisar livros</label>
       <div class="glow mt-8 flex items-center gap-3 rounded-2xl bg-[#00167A] p-2"><i data-lucide="search" class="ml-3 h-5 w-5 shrink-0 text-[#A18000]"></i> <input id="book-search" class="search-field w-full rounded-xl px-4 py-3.5 text-base outline-none" type="search"> <button data-template-id="search-button" id="search-clear" type="button" class="canva-button hidden shrink-0 rounded-xl px-4 py-3 text-sm font-bold" style="background: rgb(161, 128, 0); color: rgb(0, 0, 0); font-weight: 700; font-style: normal; font-size: 16px;">Limpar</button>
       </div>
